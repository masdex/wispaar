# ==============================================================================
# WISPAAR Headless WordPress Production Configuration
# ==============================================================================
# In Vite, client-accessible environment variables MUST start with VITE_.
# DO NOT store passwords, application passwords, or private keys here.
# ==============================================================================

# Canonical Production WordPress REST API Base URL
VITE_WP_API_URL=https://wispaar.ir

# Optional: Request Timeout in Milliseconds (default: 6000)
VITE_WP_REQUEST_TIMEOUT=6000

# Optional: Enable Local Candidate Discovery (development only, default: false)
# When set to true in dev mode, probes local candidates like http://demo.local
VITE_WP_ENABLE_DISCOVERY=false
