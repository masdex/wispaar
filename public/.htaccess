# ==============================================================================
# WISPAAR Production .htaccess (Apache + cPanel)
# Dual Routing: WordPress Backend (REST API / Admin) + React Vite Frontend (SPA)
# Target Domain: https://wispaar.ir
# ==============================================================================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ------------------------------------------------------------------------------
# 1. Enforce HTTPS & Canonical Host (https://wispaar.ir)
# ------------------------------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.wispaar\.ir$ [NC]
RewriteRule ^(.*)$ https://wispaar.ir/$1 [L,R=301]

# ------------------------------------------------------------------------------
# 2. WordPress Core, Admin, REST API & Uploads Bypass
# Never intercept WordPress administrative or API paths
# ------------------------------------------------------------------------------
RewriteRule ^wp-admin/? - [L]
RewriteRule ^wp-login\.php$ - [L]
RewriteRule ^wp-register\.php$ - [L]
RewriteRule ^xmlrpc\.php$ - [L]
RewriteRule ^wp-cron\.php$ - [L]

# Route WordPress REST API directly to WordPress index.php
RewriteCond %{REQUEST_URI} ^/wp-json [NC]
RewriteRule ^wp-json/(.*)?$ /index.php [L,QSA]

# Preserve WordPress uploads & core includes
RewriteRule ^wp-content/ - [L]
RewriteRule ^wp-includes/ - [L]

# ------------------------------------------------------------------------------
# 3. Direct Static Files & Folders (React build assets, images, robots, sitemap)
# ------------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ------------------------------------------------------------------------------
# 4. React Single Page Application (SPA) Fallback
# All frontend routes (/portfolio, /services, /blog, /start-project, etc.)
# route cleanly to React's index.html, surviving browser page refreshes
# ------------------------------------------------------------------------------
RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 5. Security & Browser Caching Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always append X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
